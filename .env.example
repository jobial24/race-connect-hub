# Copia este archivo como .env (no se sube a git)

# Asistente IA: Gemini, OpenAI o Claude (también se configura desde Admin → Configurar IA)
# AI_PROVIDER=gemini | openai | anthropic
# AI_API_KEY=
# AI_MODEL=
# (compatibilidad) GEMINI_API_KEY= / OPENAI_API_KEY= / ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Modelo opcional (por defecto gemini-2.5-flash)
GEMINI_MODEL=

# Listados de runnea a sincronizar, separados por comas
RUNNEA_PATHS=/carreras-populares/calendario/,/carreras-populares/calendario/barcelona/,/carreras-populares/calendario/tarragona/
# Horas de validez de la caché del listado
RUNNEA_MAX_PAGES=1
RUNNEA_CACHE_HOURS=12

# Revisión de webs oficiales con Gemini + Google Search
# carreras revisadas por cada `npm run sync` (cuota gratuita limitada)
AI_WEB_BUDGET=15
# carreras revisadas en cada sincronización desde la app (0 = solo botón manual)
AI_WEB_BUDGET_APP=0

# Fuentes del calendario (orden de prioridad): xipgroc = carreras catalanas con inscripción directa
RACE_SOURCES=xipgroc,spartan,ocr,runnea
# Meses de calendario de xipgroc a leer
XIPGROC_MONTHS=6
# (xipgroc,spartan,ocr,runnea). "ocr" = otras OCR encontradas con Gemini (necesita GEMINI_API_KEY)
# Países de Spartan/Tough Mudder/DEKA a incluir
SPARTAN_COUNTRIES=ES,AD

# App móvil: URL del servidor publicado (npm start en Render/Railway/Fly…)
# VITE_API_BASE=https://tu-servidor.onrender.com
# CORS_ORIGIN=*

# Base de datos (Supabase) — ya configurada por defecto en supabase/config.js
# Solo la URL y la clave PUBLICABLE. La secret key (sb_secret_…) NO se usa en esta app.
# SUPABASE_URL=https://wfvxndczesgmfansgzym.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
